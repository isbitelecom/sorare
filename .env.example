# Sorare API credentials
# Obtenez votre token JWT en vous connectant sur https://sorare.com
# Puis copiez le token depuis les cookies de votre navigateur (clé: "jwt")
# Ou utilisez l'authentification par email/mot de passe
SORARE_EMAIL=votre@email.com
SORARE_PASSWORD=votre_mot_de_passe

# Critères d'achat personnalisés (optionnels)
MAX_AGE_BUY=20           # Age maximum pour les jeunes joueurs
MIN_SCORE_BUY=50         # Score minimum (sur 100) pour recommander un achat
MAX_PRICE_ETH=0.1        # Prix maximum en ETH pour les recommandations d'achat

# Critères de vente personnalisés (optionnels)
MIN_PROFIT_PERCENT=30    # Profit minimum en % pour recommander une vente
MIN_SCORE_KEEP=40        # Score minimum pour garder une carte (sinon vendre)
